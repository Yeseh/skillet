k-1090- \nCargo.lock-1091- [[package]]\nCargo.lock:1092: name = \"skillet-compiler\"\nCargo.lock-1093- version = \"0.1.0\"\nCargo.lock-1094- \n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-1- {\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-2-   \"goalRunId\": \"goal-run-mpnrlu69-tbrad3\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json:3:   \"goal\": \"Move the lint pipeline's Phase 2 ref extraction (in `crates/skillet/src/lint/pipeline.rs`) and the `unused_fragment` rule (in `crates/skillet/src/lint/rules/unused_fragment.rs`) to use the new parser (`crate::compiler::parse::PanParse` and `crate::compiler::PanSource`) instead of regexes.\\n\\nSpecifically:\\n1. In `ParsedRefs::extract` (in `crates/skillet/src/refs.rs`), replace the regex-based extraction of typed refs and untyped backticks with the new parser. Parse the source using `Pa... [truncated]\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-4-   \"steps\": [\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-5-     {\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-5-     {\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-6-       \"id\": \"step-01\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json:7:       \"story\": \"Update lint reference extraction so supported references are recognized from the new parser while preserving the current lint-visible behavior.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-8-       \"functionalAcceptance\": [\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-9-         \"When lint processes source text, supported typed references are detected through the new parser and appear to lint consumers with the same kinds and values expected today.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-7-       \"story\": \"Update lint reference extraction so supported references are recognized from the new parser while preserving the current lint-visible behavior.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-8-       \"functionalAcceptance\": [\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json:9:         \"When lint processes source text, supported typed references are detected through the new parser and appear to lint consumers with the same kinds and values expected today.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-10-         \"Untyped backtick references that should still be linted are detected from parsed source and classified into the same lint-visible categories as before.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-11-         \"Markdown links continue to be detected for linting exactly as they are today.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-18-       \"story\": \"Update fragment-usage detection so the unused-fragment rule identifies fragment inclusions from parsed source instead of regex matching.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-19-       \"functionalAcceptance\": [\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json:20:         \"Fragment inclusions present in source files are recognized through the new parser for the purposes of the unused-fragment rule.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-21-         \"Fragments that are actually included are not reported as unused.\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/goal-execution-plan.json-22-         \"Fragments that are not included continue to be reported as unused with the same user-visible rule behavior as before.\"\n.pi/goal/goal-run-mpnrlu69-tbrad3/manifest.json-1- {\n.pi/goal/goal-run-mpnrlu69-tbrad3/manifest.json-2-   \"goalRunId\": \"goal-run-mpnrlu69-tbrad3\",\n.pi/goal/goal-run-mpnrlu69-tbrad3/manifest.json:3:   \"goal\": \"Move the lint pipeline's Phase 2 ref extraction (in `crates/skillet/src/lint/pipeline.rs`) and the `unused_fragment` rule (in `crates/skillet/src/lint/rules/unused_fragment.rs`) t